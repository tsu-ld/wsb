#!/usr/bin/env bun
import { appendFileSync } from 'node:fs'
const log = (x) => appendFileSync(process.env.FAKE_LOG, x + '\n')
const args = process.argv.slice(2)
if (args.includes('--version')) { console.log('2.1.331 (Claude Code)'); process.exit(0) }
const out = (o) => process.stdout.write(JSON.stringify(o) + '\n')
const session = 'fake-session'
let buf = ''
for await (const chunk of Bun.stdin.stream()) {
  buf += new TextDecoder().decode(chunk)
  let i
  while ((i = buf.indexOf('\n')) >= 0) {
    const line = buf.slice(0, i); buf = buf.slice(i + 1)
    if (!line.trim()) continue
    const m = JSON.parse(line)
    if (m.type === 'control_response') continue
    if (m.type === 'control_request') {
      const sub = m.request.subtype
      const response = sub === 'initialize'
        ? { commands: [], agents: [], output_style: 'default', available_output_styles: ['default'], models: [{ value: 'opus', displayName: 'Opus', description: 'x' }], account: {}, claude_code_version: '2.1.331' }
        : {}
      out({ type: 'control_response', response: { subtype: 'success', request_id: m.request_id, response } })
      if (sub === 'initialize' && m.request.sdkMcpServers?.length) {
        const send = (id, message) => out({ type: 'control_request', request_id: 'mcp' + id, request: { subtype: 'mcp_message', server_name: 'opencode', message } })
        send(1, { jsonrpc: '2.0', id: 1, method: 'initialize', params: { protocolVersion: '2025-11-25', capabilities: {}, clientInfo: { name: 'claude', version: '2.1.331' } } })
        send(2, { jsonrpc: '2.0', method: 'notifications/initialized' })
        send(3, { jsonrpc: '2.0', id: 2, method: 'tools/list', params: {} })
      }
    } else if (m.type === 'user') {
      const limited = Date.now() < Number(process.env.FAKE_RESET_SECONDS) * 1000
      const resetsAt = Number(process.env.FAKE_RESET_SECONDS)
      out({ type: 'system', subtype: 'init', session_id: session, cwd: '/', tools: [], mcp_servers: [{ name: 'opencode', status: 'connected' }], model: 'opus', permissionMode: 'default', apiKeySource: 'none', claude_code_version: '2.1.331', uuid: crypto.randomUUID() })
      if (limited) {
        out({ type: 'rate_limit_event', rate_limit_info: { status: 'rejected', resetsAt, rateLimitType: 'five_hour' }, uuid: crypto.randomUUID(), session_id: session })
        out({ type: 'assistant', message: { id: 'm', model: '<synthetic>', role: 'assistant', type: 'message', content: [{ type: 'text', text: "You've hit your 5-hour limit · resets 4:30pm (America/Argentina/Buenos_Aires)" }], stop_reason: 'stop_sequence', usage: { input_tokens: 0, output_tokens: 0 } }, parent_tool_use_id: null, error: 'rate_limit', session_id: session, uuid: crypto.randomUUID() })
        out({ type: 'result', subtype: 'success', is_error: true, api_error_status: 429, result: "You've hit your 5-hour limit · resets 4:30pm (America/Argentina/Buenos_Aires)", duration_ms: 1, duration_api_ms: 0, num_turns: 1, session_id: session, total_cost_usd: 0, usage: { input_tokens: 0, output_tokens: 0 }, modelUsage: {}, permission_denials: [], uuid: crypto.randomUUID() })
      } else {
        out({ type: 'assistant', message: { id: 'm2', model: 'opus', role: 'assistant', type: 'message', content: [{ type: 'text', text: 'DONE' }], stop_reason: 'end_turn', usage: { input_tokens: 1, output_tokens: 1 } }, parent_tool_use_id: null, session_id: session, uuid: crypto.randomUUID() })
        out({ type: 'result', subtype: 'success', is_error: false, result: 'DONE', duration_ms: 1, duration_api_ms: 0, num_turns: 1, session_id: session, total_cost_usd: 0, usage: { input_tokens: 1, output_tokens: 1 }, modelUsage: {}, permission_denials: [], uuid: crypto.randomUUID() })
      }
      log('turn ' + Date.now())
    }
  }
}
