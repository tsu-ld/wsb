{
  "name": "wsb-landing",
  "compatibility_date": "2026-11-01",
  "main": "./worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/"],
  },
  "routes": [{ "pattern": "wsb.tsu.ar", "custom_domain": true }],
}
